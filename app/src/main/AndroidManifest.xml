<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />

    <application android:theme="@style/AppTheme" android:label="IceCam v9.4.5" android:allowBackup="false" android:usesCleartextTraffic="true">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="IceCam camera hook layer" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".IceCamStateProvider" android:authorities="com.icecam.dev.provider" android:exported="true" android:grantUriPermissions="false" />
    </application>
</manifest>