#!/system/bin/sh
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "ui_print $1" > /proc/self/fd/$OUTFD; echo "ui_print" > /proc/self/fd/$OUTFD; }
ui_print "IceCam v0.4.0-dev installer"
unzip -o "$ZIPFILE" -x 'META-INF/*' -d /data/adb/modules/icecam >&2
set_perm_recursive() { chmod -R 755 "$2"; }
ui_print "Installed. Reboot required."
exit 0
