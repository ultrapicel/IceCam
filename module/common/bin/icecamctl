#!/system/bin/sh
ICE=/data/adb/icecam
LOGS="$ICE/logs"
CONFIG="$ICE/config"
STATE="$ICE/state"
MEDIA="$ICE/media"
mkdir -p "$ICE/bin" "$LOGS" "$CONFIG" "$STATE" "$MEDIA"
chmod 777 "$LOGS" 2>/dev/null
now() { date '+%F %T'; }
case "$1" in
  status)
    echo "IceCam status v0.6.0-dev"
    echo "uid=$(id)"
    echo "ctl=$0"
    echo "module_dir=$ICE"
    echo "active=$(cat "$STATE/active" 2>/dev/null)"
    echo "prepared=$(cat "$STATE/prepared" 2>/dev/null)"
    echo "media=$(ls -l "$MEDIA/source" 2>/dev/null)"
    echo "config=$(cat "$CONFIG/app_config.json" 2>/dev/null)"
    ;;
  prepare-hooks)
    echo "$(now) prepare-hooks requested v0.6.0-dev" >> "$LOGS/hook.log"
    [ -f "$STATE/active" ] || echo 0 > "$STATE/active"
    echo 1 > "$STATE/prepared"
    chmod 666 "$STATE/active" "$STATE/prepared" 2>/dev/null
    echo "prepared hooks v6"
    ;;
  start)
    echo 1 > "$STATE/active"
    chmod 666 "$STATE/active"
    echo "$(now) replacement start requested" >> "$LOGS/hook.log"
    echo "replacement active"
    ;;
  stop)
    echo 0 > "$STATE/active"
    chmod 666 "$STATE/active"
    echo "$(now) replacement stop requested" >> "$LOGS/hook.log"
    echo "replacement stopped"
    ;;
  logs)
    OUT=/sdcard/Download/icecam_debug_v6.tar.gz
    tar -czf "$OUT" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" 2>/dev/null
    echo "exported $OUT"
    ;;
  clear-logs)
    rm -f "$LOGS"/*.log
    echo "logs cleared"
    ;;
  *) echo "usage: icecamctl status|prepare-hooks|start|stop|logs|clear-logs"; exit 2 ;;
esac
