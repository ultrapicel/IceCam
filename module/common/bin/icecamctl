#!/system/bin/sh
ICE=/data/adb/icecam
LOGS="$ICE/logs"
CONFIG="$ICE/config"
STATE="$ICE/state"
MEDIA="$ICE/media"
BIN="$ICE/bin"
VERSION="v7.3"
APP_PKG="com.icecam.dev"
TARGETS="com.android.camera com.android.chrome org.telegram.messenger org.telegram.messenger.web"

init_dirs() {
  mkdir -p "$BIN" "$LOGS" "$CONFIG" "$STATE" "$MEDIA"
  touch "$LOGS/module.log" "$LOGS/hook.log"
  chmod 777 "$LOGS" 2>/dev/null
  chmod 666 "$LOGS/module.log" "$LOGS/hook.log" 2>/dev/null
  [ -f "$STATE/active" ] || echo 0 > "$STATE/active"
  [ -f "$STATE/prepared" ] || echo 0 > "$STATE/prepared"
  chmod 666 "$STATE/active" "$STATE/prepared" 2>/dev/null
  [ -f "$CONFIG/app_config.json" ] || cat > "$CONFIG/app_config.json" <<JSON
{
  "version":"7.3-diag-bundle",
  "active":false,
  "mode":"log-only",
  "cameraMode":"auto",
  "mediaType":"none",
  "mediaPath":"/data/adb/icecam/media/source"
}
JSON
  chmod 666 "$CONFIG/app_config.json" 2>/dev/null
}

write_cmd() {
  OUTFILE="$1"
  shift
  {
    echo "# $*"
    echo "# time=$(date '+%F %T')"
    "$@"
    echo "# exit=$?"
    echo
  } > "$OUTFILE" 2>&1
}

append_cmd() {
  OUTFILE="$1"
  shift
  {
    echo "# $*"
    echo "# time=$(date '+%F %T')"
    "$@"
    echo "# exit=$?"
    echo
  } >> "$OUTFILE" 2>&1
}

collect_debug_bundle() {
  TS=$(date '+%Y%m%d_%H%M%S' 2>/dev/null)
  [ -n "$TS" ] || TS=now
  OUT=/sdcard/Download/icecam_debug_${VERSION}_${TS}.tar.gz
  TMP=/data/local/tmp/icecam_debug_${VERSION}_${TS}
  rm -rf "$TMP"
  mkdir -p "$TMP" "$TMP/icecam" "$TMP/lsposed" "$TMP/system" "$TMP/packages" "$TMP/camera" "$TMP/logcat" "$TMP/media"

  echo "IceCam debug bundle $VERSION" > "$TMP/README.txt"
  echo "created=$(date '+%F %T')" >> "$TMP/README.txt"
  echo "device=$(getprop ro.product.manufacturer 2>/dev/null) $(getprop ro.product.model 2>/dev/null) / $(getprop ro.product.device 2>/dev/null)" >> "$TMP/README.txt"
  echo "sdk=$(getprop ro.build.version.sdk 2>/dev/null) android=$(getprop ro.build.version.release 2>/dev/null)" >> "$TMP/README.txt"
  echo "app=$APP_PKG" >> "$TMP/README.txt"
  echo "targets=$TARGETS" >> "$TMP/README.txt"
  echo "ctl=$0" >> "$TMP/README.txt"
  echo "uid=$(id)" >> "$TMP/README.txt" 2>&1

  cp -a "$LOGS" "$TMP/icecam/logs" 2>/dev/null
  cp -a "$CONFIG" "$TMP/icecam/config" 2>/dev/null
  cp -a "$STATE" "$TMP/icecam/state" 2>/dev/null
  ls -laR "$ICE" > "$TMP/icecam/tree.txt" 2>&1
  ls -la "$MEDIA" > "$TMP/media/media_listing.txt" 2>&1
  [ -e "$MEDIA/source" ] && ls -lZ "$MEDIA/source" > "$TMP/media/source_stat.txt" 2>&1

  # LSPosed runtime logs and config traces. Missing paths are recorded instead of failing.
  ls -laR /data/adb/lspd > "$TMP/lsposed/lspd_tree.txt" 2>&1
  cp -a /data/adb/lspd/log "$TMP/lsposed/log" 2>/dev/null
  cp -a /data/adb/lspd/config "$TMP/lsposed/config" 2>/dev/null
  cp -a /data/adb/modules/zygisk_lsposed "$TMP/lsposed/zygisk_lsposed_module" 2>/dev/null
  cp -a /data/adb/modules/riru_lsposed "$TMP/lsposed/riru_lsposed_module" 2>/dev/null

  getprop > "$TMP/system/getprop.txt" 2>&1
  ps -A > "$TMP/system/ps_A.txt" 2>&1
  mount > "$TMP/system/mount.txt" 2>&1
  uname -a > "$TMP/system/uname.txt" 2>&1
  cmd activity processes > "$TMP/system/activity_processes.txt" 2>&1
  dumpsys activity processes > "$TMP/system/dumpsys_activity_processes.txt" 2>&1
  dumpsys SurfaceFlinger --list > "$TMP/system/surfaceflinger_list.txt" 2>&1

  logcat -d -v threadtime > "$TMP/logcat/logcat_full.txt" 2>&1
  logcat -d -v threadtime | grep -E 'IceCam|LSPosed|Xposed|CameraManager|Camera2|CameraService|CameraProvider|android.hardware.Camera|chrom|telegram|camera' > "$TMP/logcat/logcat_filtered.txt" 2>&1
  logcat -b crash -d -v threadtime > "$TMP/logcat/logcat_crash.txt" 2>&1
  dmesg > "$TMP/logcat/dmesg.txt" 2>&1
  cat /proc/last_kmsg > "$TMP/logcat/last_kmsg.txt" 2>&1

  dumpsys media.camera > "$TMP/camera/dumpsys_media_camera.txt" 2>&1
  dumpsys media.camera.proxy > "$TMP/camera/dumpsys_media_camera_proxy.txt" 2>&1
  dumpsys camera > "$TMP/camera/dumpsys_camera.txt" 2>&1
  service list | grep -i camera > "$TMP/camera/service_list_camera.txt" 2>&1
  cmd media.camera get-camera-ids > "$TMP/camera/cmd_media_camera_ids.txt" 2>&1

  cmd package list packages > "$TMP/packages/package_list.txt" 2>&1
  cmd package path "$APP_PKG" > "$TMP/packages/${APP_PKG}_path.txt" 2>&1
  dumpsys package "$APP_PKG" > "$TMP/packages/${APP_PKG}_dumpsys.txt" 2>&1
  appops get "$APP_PKG" > "$TMP/packages/${APP_PKG}_appops.txt" 2>&1
  for P in $TARGETS; do
    SAFE=$(echo "$P" | tr '.:' '__')
    cmd package path "$P" > "$TMP/packages/${SAFE}_path.txt" 2>&1
    dumpsys package "$P" > "$TMP/packages/${SAFE}_dumpsys.txt" 2>&1
    appops get "$P" > "$TMP/packages/${SAFE}_appops.txt" 2>&1
  done

  # Verify installed APK contains Xposed marker when unzip is available.
  APK_PATH=$(cmd package path "$APP_PKG" 2>/dev/null | head -n 1 | sed 's/package://')
  echo "$APK_PATH" > "$TMP/packages/${APP_PKG}_base_apk_path.txt"
  if [ -n "$APK_PATH" ] && [ -f "$APK_PATH" ]; then
    ls -lZ "$APK_PATH" > "$TMP/packages/${APP_PKG}_base_apk_stat.txt" 2>&1
    unzip -l "$APK_PATH" > "$TMP/packages/${APP_PKG}_apk_unzip_list.txt" 2>&1
    unzip -p "$APK_PATH" assets/xposed_init > "$TMP/packages/${APP_PKG}_xposed_init.txt" 2>&1
  fi

  tar -czf "$OUT" -C "$TMP" . 2>/dev/null
  chmod 666 "$OUT" 2>/dev/null
  echo "exported $OUT"
  echo "include this file in ChatGPT: $OUT"
}

init_dirs

case "$1" in
  status)
    echo "IceCam status"
    echo "version=$VERSION"
    echo "uid=$(id)"
    echo "ctl=$0"
    echo "module_dir=$ICE"
    echo "active=$(cat "$STATE/active" 2>/dev/null)"
    echo "prepared=$(cat "$STATE/prepared" 2>/dev/null)"
    echo "media=$(ls -l "$MEDIA/source" 2>/dev/null)"
    echo "config=$(cat "$CONFIG/app_config.json" 2>/dev/null)"
    echo "logs=$LOGS"
    echo "lspd_log_dir=/data/adb/lspd/log"
    ;;
  prepare-hooks)
    echo "$(date '+%F %T') prepare-hooks requested" >> "$LOGS/hook.log"
    echo 1 > "$STATE/prepared"
    [ -f "$STATE/active" ] || echo 0 > "$STATE/active"
    chmod 666 "$STATE/active" "$STATE/prepared" "$CONFIG/app_config.json" 2>/dev/null
    echo "prepared hooks"
    ;;
  start)
    echo 1 > "$STATE/active"
    chmod 666 "$STATE/active" 2>/dev/null
    echo "$(date '+%F %T') replacement start requested" >> "$LOGS/hook.log"
    echo "replacement active"
    ;;
  stop)
    echo 0 > "$STATE/active"
    chmod 666 "$STATE/active" 2>/dev/null
    echo "$(date '+%F %T') replacement stop requested" >> "$LOGS/hook.log"
    echo "replacement stopped"
    ;;
  logs|debug-bundle)
    collect_debug_bundle
    ;;
  clear-logs)
    rm -f "$LOGS"/*.log
    touch "$LOGS/module.log" "$LOGS/hook.log"
    chmod 666 "$LOGS"/*.log 2>/dev/null
    logcat -c 2>/dev/null
    echo "logs cleared"
    ;;
  *)
    echo "usage: icecamctl status|prepare-hooks|start|stop|logs|debug-bundle|clear-logs"
    exit 2
    ;;
esac
