#!/system/bin/sh
ICE=/data/adb/icecam
LOGS="$ICE/logs"
CONFIG="$ICE/config"
STATE="$ICE/state"
mkdir -p "$ICE/bin" "$LOGS" "$CONFIG" "$STATE"
chmod 777 "$LOGS" 2>/dev/null

now() { date '+%F %T'; }

case "$1" in
  status)
    echo "IceCam status"
    echo "uid=$(id)"
    echo "ctl=$0"
    echo "module_dir=$ICE"
    echo "logs=$LOGS"
    echo "prepared=$(cat "$STATE/prepared" 2>/dev/null)"
    ;;
  prepare-hooks)
    echo "$(now) prepare-hooks requested" >> "$LOGS/hook.log"
    cat > "$CONFIG/hook_config.json" <<EOF
{
  "enabled": true,
  "mode": "log-only",
  "version": "0.4.0-dev",
  "targets": ["camera2", "camera1"],
  "note": "v4 logs CameraManager/Camera.open calls only"
}
EOF
    echo 1 > "$STATE/prepared"
    chmod 666 "$CONFIG/hook_config.json" "$STATE/prepared" 2>/dev/null
    chmod 777 "$LOGS" 2>/dev/null
    echo "prepared hooks"
    ;;
  logs)
    OUT=/sdcard/Download/icecam_debug_v4.tar.gz
    tar -czf "$OUT" "$LOGS" "$CONFIG" "$STATE" 2>/dev/null
    echo "exported $OUT"
    ;;
  *)
    echo "IceCam control"
    echo "usage: icecamctl status|prepare-hooks|logs"
    exit 2
    ;;
esac
