#!/system/bin/sh
ICE=/data/adb/icecam
LOGS="$ICE/logs"
CONFIG="$ICE/config"
STATE="$ICE/state"
MEDIA="$ICE/media"
CACHE="$ICE/cache"
BIN="$ICE/bin"
VERSION="v9.6.3"
APP_PKG="com.icecam.dev"
TARGETS="com.android.camera com.android.chrome org.telegram.messenger org.telegram.messenger.web"


log_module() {
  mkdir -p "$LOGS" 2>/dev/null
  echo "$(date '+%F %T') $*" >> "$LOGS/module.log" 2>/dev/null
}

clean_legacy() {
  # Keep current config/media/state where possible, but remove stale temp/debug/cache artefacts
  # left by older v9.x builds and broken GitHub/module attempts.
  mkdir -p "$ICE" /data/local/tmp 2>/dev/null
  rm -rf /data/local/tmp/icecam_debug_* /data/local/tmp/icecam_full_debug_* 2>/dev/null
  rm -rf "$ICE/tmp" "$ICE/debug" "$ICE/old" "$ICE/.old" 2>/dev/null
  find "$ICE" -maxdepth 2 -type f \( \
    -name '*.tmp' -o -name '*.bak' -o -name '*.old' -o -name '*~' -o \
    -name 'surface_spam.log' -o -name 'full_logcat.txt' -o -name 'dmesg_full.txt' \
  \) -delete 2>/dev/null
  # Reset known noisy JSONL caches on install/prepare/start so new bundles reflect the current run.
  : > "$CACHE/camera_profiles.jsonl" 2>/dev/null
  : > "$CACHE/hook_access_probe.log" 2>/dev/null
  : > "$CACHE/capture_session_events.jsonl" 2>/dev/null
  : > "$CACHE/surface_events.jsonl" 2>/dev/null
  : > "$CACHE/surface_ownership_events.jsonl" 2>/dev/null
  : > "$CACHE/renderer_events.jsonl" 2>/dev/null
  log_module "legacy cleanup completed"
}

mark_root_granted() {
  mkdir -p "$STATE" 2>/dev/null
  echo 1 > "$STATE/root_granted" 2>/dev/null
  echo "$(date '+%F %T')" > "$STATE/root_granted_at" 2>/dev/null
  chmod 666 "$STATE/root_granted" "$STATE/root_granted_at" 2>/dev/null
}

safe_root_probe() {
  # Android 12-15 compatibility rule:
  # never mutate the foreground app permission/appop state from root.
  # MIUI/AOSP may kill the app when storage permissions/appops change
  # (especially MANAGE_EXTERNAL_STORAGE / READ_MEDIA_* / READ_EXTERNAL_STORAGE).
  # Runtime permissions are handled by the app; media is SAF/app-private-copy based.
  mark_root_granted
  log_module "safe root probe completed for $APP_PKG; no pm grant/appops mutation"
}

init_dirs() {
  mkdir -p "$BIN" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE"
  touch "$LOGS/module.log" "$LOGS/hook.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl"
  chmod 755 /data/adb 2>/dev/null
  chmod 777 "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
  chmod 666 "$LOGS/module.log" "$LOGS/hook.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl" 2>/dev/null
  [ -f "$STATE/active" ] || echo 0 > "$STATE/active"
  [ -f "$STATE/prepared" ] || echo 0 > "$STATE/prepared"
  chmod 666 "$STATE/active" "$STATE/prepared" 2>/dev/null
  [ -f "$CONFIG/app_config.json" ] || cat > "$CONFIG/app_config.json" <<JSON
{
  "version":"v9.6.3-safe-surface-classifier",
  "active":false,
  "mode":"log-only",
  "cameraMode":"auto",
  "compatibilityMode":"strict-real",
  "mediaType":"none",
  "mediaPath":"/data/adb/icecam/media/source",
  "mediaMetaPath":"/data/adb/icecam/media/source.meta.json",
  "pipelineStage":"system-camera-provider-probe-passive"
}
JSON
  chmod 666 "$CONFIG/app_config.json" 2>/dev/null
  chmod 777 "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
}

write_cmd() {
  OUTFILE="$1"
  shift
  {
    echo "# $*"
    echo "# time=$(date '+%F %T')"
    "$@"
    echo "# exit=$?"
    echo
  } > "$OUTFILE" 2>&1
}

append_cmd() {
  OUTFILE="$1"
  shift
  {
    echo "# $*"
    echo "# time=$(date '+%F %T')"
    "$@"
    echo "# exit=$?"
    echo
  } >> "$OUTFILE" 2>&1
}


collect_system_camera_probe() {
  OUTDIR="$1"
  [ -n "$OUTDIR" ] || OUTDIR="$ICE/system_camera_probe"
  mkdir -p "$OUTDIR" "$OUTDIR/hal" "$OUTDIR/dev" "$OUTDIR/vintf" "$OUTDIR/vendor" "$OUTDIR/services" "$OUTDIR/props" "$OUTDIR/selinux" "$OUTDIR/provider_proc" "$OUTDIR/init" "$OUTDIR/route" "$OUTDIR/external" 2>/dev/null

  echo "IceCam system camera probe $VERSION" > "$OUTDIR/README.txt"
  echo "created=$(date '+%F %T')" >> "$OUTDIR/README.txt"
  echo "purpose=decide whether IceCam can move from app/API hooks toward system camera provider/HAL path" >> "$OUTDIR/README.txt"
  echo "note=no patching is performed by this probe" >> "$OUTDIR/README.txt"

  write_cmd "$OUTDIR/props/android_build.txt" getprop ro.build.version.release
  getprop > "$OUTDIR/props/getprop_all.txt" 2>&1
  getprop | grep -Ei 'camera|vendor.camera|persist.vendor.camera|ro.hardware|ro.product|ro.vendor|ro.board|ro.boot|vintf|treble|first_api_level|sdk|zygote' > "$OUTDIR/props/getprop_camera_relevant.txt" 2>&1

  write_cmd "$OUTDIR/services/service_list_camera.txt" sh -c "service list | grep -i camera || true"
  write_cmd "$OUTDIR/services/cmd_media_camera_ids.txt" sh -c "cmd media.camera get-camera-ids 2>&1 || true"
  write_cmd "$OUTDIR/services/dumpsys_media_camera.txt" dumpsys media.camera
  write_cmd "$OUTDIR/services/dumpsys_camera_provider.txt" sh -c "dumpsys android.hardware.camera.provider.ICameraProvider/default 2>&1 || true"
  write_cmd "$OUTDIR/services/lshal_camera.txt" sh -c "lshal 2>/dev/null | grep -i camera || true"
  write_cmd "$OUTDIR/services/hwservicemanager_camera.txt" sh -c "service list | grep -i hwservicemanager; lshal 2>/dev/null | grep -Ei 'android.hardware.camera|provider' || true"

  write_cmd "$OUTDIR/dev/dev_video.txt" sh -c "ls -la /dev/video* 2>/dev/null || true"
  write_cmd "$OUTDIR/dev/dev_media.txt" sh -c "ls -la /dev/media* /dev/v4l* 2>/dev/null || true"
  write_cmd "$OUTDIR/dev/dev_video_selinux.txt" sh -c "ls -lZ /dev/video* /dev/media* /dev/v4l* 2>/dev/null || true"
  write_cmd "$OUTDIR/dev/proc_config_v4l2.txt" sh -c "zcat /proc/config.gz 2>/dev/null | grep -Ei 'V4L2|VIDEO_DEV|UVC|V4L2LOOPBACK|MEDIA_SUPPORT' || true"
  write_cmd "$OUTDIR/dev/sys_class_video4linux.txt" sh -c "find /sys/class/video4linux -maxdepth 3 -type f -name name -o -name index 2>/dev/null | sort | while read f; do echo '---'\$f; cat \$f 2>/dev/null; done || true"

  write_cmd "$OUTDIR/hal/vendor_bin_hw_camera.txt" sh -c "ls -laZ /vendor/bin/hw/*camera* /odm/bin/hw/*camera* /system/bin/hw/*camera* 2>/dev/null || true"
  write_cmd "$OUTDIR/hal/vendor_lib_camera.txt" sh -c "ls -laZ /vendor/lib*/hw/*camera* /odm/lib*/hw/*camera* /system/lib*/hw/*camera* 2>/dev/null || true"
  write_cmd "$OUTDIR/hal/camera_provider_processes.txt" sh -c "ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null | grep -Ei 'camera|provider' | grep -v grep || ps -A | grep -Ei 'camera|provider' || true"

  # v9.6.3: deep provider process probe. Read-only only.
  PIDS=$(ps -A 2>/dev/null | grep -Ei 'camera.*provider|provider.*camera|cameraserver' | grep -v grep | awk '{print $2}' | tr '\n' ' ')
  echo "$PIDS" > "$OUTDIR/provider_proc/provider_pids.txt" 2>&1
  for PID in $PIDS; do
    PD="$OUTDIR/provider_proc/pid_$PID"
    mkdir -p "$PD" 2>/dev/null
    write_cmd "$PD/status.txt" sh -c "cat /proc/$PID/status 2>&1 || true"
    write_cmd "$PD/cmdline.txt" sh -c "tr '\0' ' ' < /proc/$PID/cmdline 2>&1 || true"
    write_cmd "$PD/comm.txt" sh -c "cat /proc/$PID/comm 2>&1 || true"
    write_cmd "$PD/attr_current.txt" sh -c "cat /proc/$PID/attr/current 2>&1 || true"
    write_cmd "$PD/maps_camera_relevant.txt" sh -c "cat /proc/$PID/maps 2>/dev/null | grep -Ei 'camera|qcom|mmcamera|chi|camx|chromatix|sensor|eeprom|actuator|ois|jpeg|gralloc|c2d|adreno|libhidl|aidl|binder' || true"
    write_cmd "$PD/fd_listing.txt" sh -c "ls -la /proc/$PID/fd 2>&1 | head -n 1200 || true"
    write_cmd "$PD/fd_camera_relevant.txt" sh -c "for f in /proc/$PID/fd/*; do T=$(readlink $f 2>/dev/null); echo $f '->' $T; done | grep -Ei 'video|media|camera|cam|ion|dmabuf|binder|ashmem|kgsl|qcom|vendor' || true"
    write_cmd "$PD/mountinfo_vendor.txt" sh -c "cat /proc/$PID/mountinfo 2>/dev/null | grep -Ei 'vendor|odm|system|apex|magisk|ksu|overlay|icecam' || true"
  done

  # v9.6.3: init/service and external provider feasibility probe.
  write_cmd "$OUTDIR/init/init_camera_rc_refs.txt" sh -c "grep -Rni 'camera.*provider\|provider.*camera\|cameraserver\|android.hardware.camera' /vendor/etc/init /odm/etc/init /system/etc/init /system_ext/etc/init /product/etc/init 2>/dev/null || true"
  write_cmd "$OUTDIR/init/init_camera_rc_files.txt" sh -c "find /vendor/etc/init /odm/etc/init /system/etc/init /system_ext/etc/init /product/etc/init -type f -iname '*camera*' -print 2>/dev/null | sort | while read f; do echo '---'\$f; sed -n '1,220p' \$f; done || true"
  write_cmd "$OUTDIR/external/external_provider_bins.txt" sh -c "ls -laZ /vendor/bin/hw/*external*camera* /system/bin/hw/*external*camera* /odm/bin/hw/*external*camera* 2>/dev/null || true"
  write_cmd "$OUTDIR/external/external_provider_libs.txt" sh -c "ls -laZ /vendor/lib*/hw/*external*camera* /system/lib*/hw/*external*camera* /odm/lib*/hw/*external*camera* 2>/dev/null || true"
  write_cmd "$OUTDIR/external/external_manifest_refs.txt" sh -c "grep -Rni 'external.*camera\|camera.*external' /vendor/etc /odm/etc /system/etc /system_ext/etc /product/etc 2>/dev/null | head -n 500 || true"
  write_cmd "$OUTDIR/dev/sys_video4linux_uevent.txt" sh -c "for d in /sys/class/video4linux/*; do [ -d \$d ] || continue; echo '---'\$d; cat \$d/name 2>/dev/null; cat \$d/dev 2>/dev/null; cat \$d/uevent 2>/dev/null; readlink -f \$d/device 2>/dev/null; done || true"
  write_cmd "$OUTDIR/dev/sys_media_uevent.txt" sh -c "for d in /sys/class/media/*; do [ -d \$d ] || continue; echo '---'\$d; cat \$d/dev 2>/dev/null; cat \$d/uevent 2>/dev/null; readlink -f \$d/device 2>/dev/null; done || true"

  write_cmd "$OUTDIR/vintf/manifest_camera_refs.txt" sh -c "grep -Rni 'android.hardware.camera\|camera.provider\|ICameraProvider' /vendor/etc/vintf /odm/etc/vintf /system/etc/vintf /system_ext/etc/vintf /product/etc/vintf 2>/dev/null || true"
  write_cmd "$OUTDIR/vintf/external_camera_config.txt" sh -c "for f in /vendor/etc/external_camera_config.xml /odm/etc/external_camera_config.xml /system/etc/external_camera_config.xml /system_ext/etc/external_camera_config.xml; do [ -f \$f ] && echo '---'\$f && cat \$f; done 2>/dev/null || true"
  write_cmd "$OUTDIR/vintf/camera_xml_listing.txt" sh -c "find /vendor/etc /odm/etc /system/etc /system_ext/etc /product/etc -maxdepth 4 -type f \( -iname '*camera*.xml' -o -iname '*camera*.json' -o -iname '*camera*.conf' \) -print 2>/dev/null | sort"

  write_cmd "$OUTDIR/selinux/getenforce.txt" getenforce
  write_cmd "$OUTDIR/selinux/camera_contexts.txt" sh -c "grep -Rni 'camera' /vendor/etc/selinux /odm/etc/selinux /system/etc/selinux /system_ext/etc/selinux 2>/dev/null | head -n 500 || true"
  logcat -d -v threadtime | grep -i 'avc: denied' | grep -iE 'camera|provider|video|v4l|icecam|adb_data_file' | tail -n 800 > "$OUTDIR/selinux/avc_camera_denials.txt" 2>&1

  {
    echo "IceCam v9.6.3 auto-pipeline Camera2 surface shadow assessment"
    echo "created=$(date '+%F %T')"
    echo
    echo "Detected signals:"
    if grep -Rqi 'android.hardware.camera.provider.ICameraProvider/default' "$OUTDIR" 2>/dev/null; then echo "- aidl_provider=maybe_present"; else echo "- aidl_provider=not_detected"; fi
    if grep -Rqi 'android.hardware.camera.provider@' "$OUTDIR" 2>/dev/null; then echo "- hidl_provider=present"; else echo "- hidl_provider=not_detected"; fi
    if grep -Rqi 'external.*camera\|camera.*external' "$OUTDIR/external" "$OUTDIR/vintf" 2>/dev/null; then echo "- external_camera_route=maybe_present"; else echo "- external_camera_route=not_detected"; fi
    if ls /dev/video* >/dev/null 2>&1; then echo "- dev_video_nodes=present"; else echo "- dev_video_nodes=absent"; fi
    if grep -Rqi 'V4L2LOOPBACK.*=y\|V4L2LOOPBACK.*=m' "$OUTDIR/dev" 2>/dev/null; then echo "- v4l2loopback=kernel_available"; else echo "- v4l2loopback=not_detected"; fi
    if grep -Rqi 'camera.qcom.so\|mmcamera\|camx\|chi' "$OUTDIR/provider_proc" "$OUTDIR/hal" 2>/dev/null; then echo "- vendor_camera_stack=qcom_like"; else echo "- vendor_camera_stack=unknown_or_not_visible"; fi
    echo
    echo "Route ranking:"
    if grep -Rqi 'external.*camera\|camera.*external' "$OUTDIR/external" "$OUTDIR/vintf" 2>/dev/null; then
      echo "1. external_provider_route: candidate"
    else
      echo "1. external_provider_route: weak/no service or config detected"
    fi
    if grep -Rqi 'camera.qcom.so\|android.hardware.camera.provider@2.4' "$OUTDIR/provider_proc" "$OUTDIR/hal" "$OUTDIR/services" 2>/dev/null; then
      echo "2. vendor_provider_shim: research candidate, but vendor/SELinux/init-risky"
    else
      echo "2. vendor_provider_shim: unknown"
    fi
    if grep -Rqi 'V4L2LOOPBACK.*=y\|V4L2LOOPBACK.*=m' "$OUTDIR/dev" 2>/dev/null; then
      echo "3. v4l2loopback_route: possible"
    else
      echo "3. v4l2loopback_route: not portable / no kernel support detected"
    fi
    echo "4. LSPosed Surface/CaptureSession injection: portable fallback, not a true system camera"
    echo
    echo "No service replacement, SELinux change, vendor mount, or frame injection was performed by this probe."
  } > "$OUTDIR/system_camera_path_assessment.txt"

  cp "$OUTDIR/system_camera_path_assessment.txt" "$OUTDIR/route/route_classifier.txt" 2>/dev/null
  echo "system camera probe written to $OUTDIR"
}

collect_lite_debug_bundle() {
  TS=$(date '+%Y%m%d_%H%M%S' 2>/dev/null)
  [ -n "$TS" ] || TS=now
  OUT=/sdcard/Download/icecam_debug_${VERSION}_${TS}.tar.gz
  TMP=/data/local/tmp/icecam_debug_${VERSION}_${TS}
  rm -rf "$TMP"
  mkdir -p "$TMP" "$TMP/icecam/logs" "$TMP/icecam/config" "$TMP/icecam/state" "$TMP/icecam/cache" "$TMP/media" "$TMP/logcat" "$TMP/system" "$TMP/camera" "$TMP/packages" "$TMP/provider" "$TMP/selinux" "$TMP/system_camera_probe"

  FILTER_RE='IceCam/Hook|IceCam/Provider|ProviderBridgeJson|ProviderProbe|ProfileCacheJson|CaptureSessionJson|SurfaceOwnerJson|RendererSandbox|AutoPipelineJson|Camera2SurfaceShadowJson|Camera1InjectionJson|AccessProbe|LSPosed|Xposed|CameraManager|CameraDevice|CameraCaptureSession|CaptureRequest|OutputConfiguration|CameraService|CameraProvider|android.hardware.Camera|openCamera|getCameraIdList|getCameraCharacteristics|createCaptureSession|createCaptureRequest|setRepeatingRequest|addTarget|removeTarget|SurfaceJson|SurfaceTexture|ImageReader|RendererSandbox'
  TARGET_EVENT_RE='package=(com.android.camera|com.android.chrome|org.telegram.messenger|org.telegram.messenger.web)|"package":"(com.android.camera|com.android.chrome|org.telegram.messenger|org.telegram.messenger.web)"'

  echo "IceCam lite debug bundle $VERSION" > "$TMP/summary.txt"
  echo "created=$(date '+%F %T')" >> "$TMP/summary.txt"
  echo "device=$(getprop ro.product.manufacturer 2>/dev/null) $(getprop ro.product.model 2>/dev/null) / $(getprop ro.product.device 2>/dev/null)" >> "$TMP/summary.txt"
  echo "sdk=$(getprop ro.build.version.sdk 2>/dev/null) android=$(getprop ro.build.version.release 2>/dev/null)" >> "$TMP/summary.txt"
  echo "uid=$(id)" >> "$TMP/summary.txt" 2>&1
  echo "active=$(cat "$STATE/active" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "prepared=$(cat "$STATE/prepared" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "media_source_exists=$([ -e "$MEDIA/source" ] && echo yes || echo no)" >> "$TMP/summary.txt"
  echo "config_exists=$([ -e "$CONFIG/app_config.json" ] && echo yes || echo no)" >> "$TMP/summary.txt"
  echo "cache_dir=$CACHE" >> "$TMP/summary.txt"

  cp "$LOGS/hook.log" "$TMP/icecam/logs/hook.log" 2>/dev/null
  cp "$LOGS/module.log" "$TMP/icecam/logs/module.log" 2>/dev/null
  cp "$CONFIG/app_config.json" "$TMP/icecam/config/app_config.json" 2>/dev/null
  cp "$STATE/active" "$TMP/icecam/state/active" 2>/dev/null
  cp "$STATE/prepared" "$TMP/icecam/state/prepared" 2>/dev/null
  cp "$CACHE/camera_profiles.json" "$TMP/icecam/cache/camera_profiles.json" 2>/dev/null
  cp "$CACHE/camera_profiles.jsonl" "$TMP/icecam/cache/camera_profiles.jsonl" 2>/dev/null
  cp "$CACHE/hook_access_probe.log" "$TMP/icecam/cache/hook_access_probe.log" 2>/dev/null
  cp "$CACHE/capture_session_events.jsonl" "$TMP/icecam/cache/capture_session_events.jsonl" 2>/dev/null
  cp "$CACHE/surface_events.jsonl" "$TMP/icecam/cache/surface_events.jsonl" 2>/dev/null
  cp "$CACHE/surface_ownership_events.jsonl" "$TMP/icecam/cache/surface_ownership_events.jsonl" 2>/dev/null
  cp "$CACHE/renderer_events.jsonl" "$TMP/icecam/cache/renderer_events.jsonl" 2>/dev/null

  ls -laR "$ICE" > "$TMP/icecam/tree.txt" 2>&1
  { ls -ld /data/adb "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE"; ls -l "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE"; } > "$TMP/icecam/permissions.txt" 2>&1

  ls -la "$MEDIA" > "$TMP/media/media_listing.txt" 2>&1
  [ -e "$MEDIA/source" ] && ls -lZ "$MEDIA/source" > "$TMP/media/source_stat.txt" 2>&1
  [ -e "$MEDIA/source" ] && { wc -c "$MEDIA/source"; md5sum "$MEDIA/source" 2>/dev/null; sha256sum "$MEDIA/source" 2>/dev/null; } > "$TMP/media/source_hashes.txt" 2>&1
  [ -e "$MEDIA/source.meta.json" ] && cp "$MEDIA/source.meta.json" "$TMP/media/source.meta.json" 2>/dev/null

  logcat -d -v threadtime | grep -E "$FILTER_RE" | grep -v '"package":"com.icecam.dev"' | grep -v 'package=com.icecam.dev' | grep -v 'Surface.isValid' | tail -n 6000 > "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>&1
  grep -E 'IceCam/Hook|ProfileCacheJson|CaptureSessionJson|SurfaceOwnerJson|RendererSandbox|AccessProbe' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/logcat/icecam_only.txt" 2>/dev/null
  grep -E "$TARGET_EVENT_RE" "$TMP/logcat/icecam_only.txt" > "$TMP/logcat/target_icecam_events.txt" 2>/dev/null
  grep -E 'LSPosed|Xposed' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | grep -E 'IceCam|com.android.camera|com.android.chrome|org.telegram' | tail -n 1000 > "$TMP/logcat/lsposed_only.txt" 2>/dev/null
  grep -E 'CameraManager|CameraDevice|CameraCaptureSession|CaptureRequest|OutputConfiguration|CameraService|CameraProvider|android.hardware.Camera|openCamera|getCameraIdList|getCameraCharacteristics|createCaptureSession|createCaptureRequest|setRepeatingRequest|addTarget|removeTarget|SurfaceOwnerJson|SurfaceJson|SurfaceTexture|ImageReader|RendererSandbox' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/logcat/camera_only.txt" 2>/dev/null
  grep 'ProfileCacheJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | sed 's/^.*ProfileCacheJson //' > "$TMP/icecam/cache/camera_profiles_from_logcat.jsonl" 2>/dev/null
  grep 'CaptureSessionJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | sed 's/^.*CaptureSessionJson //' > "$TMP/icecam/cache/capture_session_events_from_logcat.jsonl" 2>/dev/null
  grep 'SurfaceJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | sed 's/^.*SurfaceJson //' > "$TMP/icecam/cache/surface_events_from_logcat.jsonl" 2>/dev/null
  grep 'SurfaceOwnerJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | sed 's/^.*SurfaceOwnerJson //' > "$TMP/icecam/cache/surface_ownership_from_logcat.jsonl" 2>/dev/null
  grep 'RendererSandboxJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | sed 's/^.*RendererSandboxJson //' > "$TMP/icecam/cache/renderer_events_from_logcat.jsonl" 2>/dev/null
  grep -E 'AccessProbe|ProviderProbe' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/icecam/cache/hook_access_probe_from_logcat.txt" 2>/dev/null
  grep 'ProviderBridgeJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/provider/provider_bridge_from_logcat.txt" 2>/dev/null
  grep -o 'providerStats=[^ ]*' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" | tail -n 200 > "$TMP/provider/provider_cache_stats_from_logcat.txt" 2>/dev/null
  content query --uri content://com.icecam.dev.provider/config > "$TMP/provider/config_query.txt" 2>&1
  content query --uri content://com.icecam.dev.provider/state > "$TMP/provider/state_query.txt" 2>&1
  content query --uri content://com.icecam.dev.provider/media-meta > "$TMP/provider/media_meta_query.txt" 2>&1
  logcat -b crash -d -v threadtime | grep -E 'IceCam|LSPosed|Xposed|Camera|android.hardware.camera|org.telegram|chrome' | tail -n 500 > "$TMP/logcat/crash_filtered.txt" 2>&1

  getenforce > "$TMP/selinux/getenforce.txt" 2>&1
  ls -Zd /data/adb "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" > "$TMP/selinux/lsZ_data_adb_icecam.txt" 2>&1
  logcat -d -v threadtime | grep -i 'avc: denied' | grep -iE 'icecam|adb_data_file|camera|provider' | tail -n 400 > "$TMP/selinux/avc_denials_icecam.txt" 2>&1
  dmesg | grep -i 'avc: denied' | grep -iE 'icecam|adb_data_file|camera|provider' | tail -n 400 > "$TMP/selinux/dmesg_avc_denials_icecam.txt" 2>&1
  getprop | grep -Ei 'camera|vendor.camera|product|device|build.version|zygote|dalvik|ro.boot' > "$TMP/system/getprop_relevant.txt" 2>&1
  ps -A | grep -Ei 'camera|telegram|chrome|icecam|lspd|zygote' > "$TMP/system/ps_relevant.txt" 2>&1
  cmd activity processes | grep -Ei 'camera|telegram|chrome|icecam|lspd' > "$TMP/system/activity_processes_relevant.txt" 2>&1

  dumpsys media.camera > "$TMP/camera/dumpsys_media_camera.txt" 2>&1
  service list | grep -i camera > "$TMP/camera/service_list_camera.txt" 2>&1
  cmd media.camera get-camera-ids > "$TMP/camera/cmd_media_camera_ids.txt" 2>&1
  collect_system_camera_probe "$TMP/system_camera_probe" >/dev/null 2>&1
  cp "$TMP/system_camera_probe/route/route_classifier.txt" "$TMP/camera/low_level_route_classifier.txt" 2>/dev/null

  cmd package path "$APP_PKG" > "$TMP/packages/${APP_PKG}_path.txt" 2>&1
  dumpsys package "$APP_PKG" | grep -Ei 'Package \[|versionName|versionCode|codePath|resourcePath|legacy|xposed|requested permissions|granted=true' > "$TMP/packages/${APP_PKG}_summary.txt" 2>&1
  APK_PATH=$(cmd package path "$APP_PKG" 2>/dev/null | head -n 1 | sed 's/package://')
  echo "$APK_PATH" > "$TMP/packages/${APP_PKG}_base_apk_path.txt"
  if [ -n "$APK_PATH" ] && [ -f "$APK_PATH" ]; then
    unzip -p "$APK_PATH" assets/xposed_init > "$TMP/packages/${APP_PKG}_xposed_init.txt" 2>&1
    unzip -l "$APK_PATH" | grep -E 'xposed_init|IceCamHook|AndroidManifest' > "$TMP/packages/${APP_PKG}_apk_key_entries.txt" 2>&1
  fi

  for P in $TARGETS; do
    SAFE=$(echo "$P" | tr '.:' '__')
    cmd package path "$P" > "$TMP/packages/${SAFE}_path.txt" 2>&1
    appops get "$P" | grep -Ei 'CAMERA|RECORD_AUDIO|RUN_IN_BACKGROUND|SYSTEM_ALERT' > "$TMP/packages/${SAFE}_appops_camera.txt" 2>&1
  done

  echo "" >> "$TMP/summary.txt"
  echo "Key counters:" >> "$TMP/summary.txt"
  echo "load_count=$(grep -c '\[LOAD\]' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "target_event_count=$(wc -l < "$TMP/logcat/target_icecam_events.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "target_load_count=$(grep -c '\[LOAD\]' "$TMP/logcat/target_icecam_events.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "openCamera_count=$(grep -c 'openCamera' "$TMP/logcat/target_icecam_events.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "getCameraIdList_count=$(grep -c 'getCameraIdList' "$TMP/logcat/target_icecam_events.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "getCameraCharacteristics_count=$(grep -c 'getCameraCharacteristics' "$TMP/logcat/target_icecam_events.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "captureSession_count=$(grep -c 'CaptureSessionJson\|createCaptureSession' "$TMP/logcat/target_icecam_events.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "profile_json_count=$(wc -l < "$TMP/icecam/cache/camera_profiles_from_logcat.jsonl" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "surface_json_count=$(wc -l < "$TMP/icecam/cache/surface_events_from_logcat.jsonl" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "surface_ownership_count=$(wc -l < "$TMP/icecam/cache/surface_ownership_from_logcat.jsonl" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "renderer_event_count=$(wc -l < "$TMP/icecam/cache/renderer_events.jsonl" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "renderer_logcat_count=$(wc -l < "$TMP/icecam/cache/renderer_events_from_logcat.jsonl" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "provider_probe_count=$(grep -c 'ProviderProbe' "$TMP/icecam/cache/hook_access_probe_from_logcat.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "provider_bridge_logcat_count=$(wc -l < "$TMP/provider/provider_bridge_from_logcat.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "last_provider_stats=$(grep -o 'providerStats=[^ ]*' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | tail -n 1)" >> "$TMP/summary.txt"
  echo "provider_cache_stat_lines=$(grep -c 'providerStats=' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "direct_data_adb_disabled_lines=$(grep -c 'directDataAdbIo=disabled' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "avc_denial_count=$(wc -l < "$TMP/selinux/avc_denials_icecam.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "route_classifier_present=$([ -s "$TMP/camera/low_level_route_classifier.txt" ] && echo yes || echo no)" >> "$TMP/summary.txt"
  echo "provider_pid_count=$(wc -w < "$TMP/system_camera_probe/provider_proc/provider_pids.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "external_route_refs=$(grep -Rci 'external.*camera\|camera.*external' "$TMP/system_camera_probe/external" "$TMP/system_camera_probe/vintf" 2>/dev/null | awk -F: '{s+=$2} END{print s+0}')" >> "$TMP/summary.txt"
  echo "capture_request_target_count=$(grep -c 'CaptureRequest.Builder.addTarget\|requestTargets' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "camera1_injection_count=$(grep -c 'Camera1InjectionJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "auto_pipeline_count=$(grep -c 'AutoPipelineJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "camera2_surface_shadow_count=$(grep -c 'Camera2SurfaceShadowJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "camera2_surface_paint_ok_count=$(grep 'Camera2SurfaceShadowJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'paint-ok')" >> "$TMP/summary.txt"
  echo "camera2_surface_paint_fail_count=$(grep 'Camera2SurfaceShadowJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep 'paint-probe' | grep -vc 'paint-ok')" >> "$TMP/summary.txt"
  echo "camera2_surface_render_count=$(grep -c 'Camera2SurfaceRenderJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "camera2_surface_render_start_count=$(grep 'Camera2SurfaceRenderJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'surface_render_start')" >> "$TMP/summary.txt"
  echo "camera2_surface_render_frame_count=$(grep 'Camera2SurfaceRenderJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'surface_render_frame')" >> "$TMP/summary.txt"
  echo "camera2_surface_render_error_count=$(grep 'Camera2SurfaceRenderJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'surface_render_error')" >> "$TMP/summary.txt"
  echo "camera2_surface_render_stop_count=$(grep 'Camera2SurfaceRenderJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'surface_render_stop')" >> "$TMP/summary.txt"
  echo "surface_classifier_count=$(grep -c 'SurfaceClassifierJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null)" >> "$TMP/summary.txt"
  echo "surface_classifier_render_true_count=$(grep 'SurfaceClassifierJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c '"render":true')" >> "$TMP/summary.txt"
  echo "surface_classifier_image_reader_skip_count=$(grep 'SurfaceClassifierJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'image-reader')" >> "$TMP/summary.txt"
  echo "surface_classifier_chrome_skip_count=$(grep 'SurfaceClassifierJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" 2>/dev/null | grep -c 'chrome-webview-log-only')" >> "$TMP/summary.txt"
  grep 'Camera1InjectionJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/icecam/cache/camera1_injection_from_logcat.jsonl" 2>/dev/null
  grep 'AutoPipelineJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/icecam/cache/auto_pipeline_from_logcat.jsonl" 2>/dev/null
  grep 'Camera2SurfaceShadowJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/icecam/cache/camera2_surface_shadow_from_logcat.jsonl" 2>/dev/null
  grep 'Camera2SurfaceRenderJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/icecam/cache/camera2_surface_render_from_logcat.jsonl" 2>/dev/null
  grep 'SurfaceClassifierJson' "$TMP/logcat/icecam_camera_lsposed_filtered.txt" > "$TMP/icecam/cache/surface_classifier_from_logcat.jsonl" 2>/dev/null

  find "$TMP" -type f -size +800k -exec sh -c 'tail -c 800000 "$1" > "$1.trim" && mv "$1.trim" "$1"' _ {} \; 2>/dev/null
  tar -czf "$OUT" -C "$TMP" . 2>/dev/null
  chmod 666 "$OUT" 2>/dev/null
  echo "exported lite $OUT"
  echo "include this file in ChatGPT: $OUT"
}

collect_full_debug_bundle() {
  TS=$(date '+%Y%m%d_%H%M%S' 2>/dev/null)
  [ -n "$TS" ] || TS=now
  OUT=/sdcard/Download/icecam_full_debug_${VERSION}_${TS}.tar.gz
  TMP=/data/local/tmp/icecam_full_debug_${VERSION}_${TS}
  rm -rf "$TMP"
  mkdir -p "$TMP" "$TMP/icecam" "$TMP/lsposed" "$TMP/system" "$TMP/packages" "$TMP/camera" "$TMP/logcat" "$TMP/media" "$TMP/provider" "$TMP/selinux"
  echo "IceCam FULL debug bundle $VERSION" > "$TMP/README.txt"
  echo "created=$(date '+%F %T')" >> "$TMP/README.txt"
  cp -a "$LOGS" "$TMP/icecam/logs" 2>/dev/null
  cp -a "$CONFIG" "$TMP/icecam/config" 2>/dev/null
  cp -a "$STATE" "$TMP/icecam/state" 2>/dev/null
  cp -a "$CACHE" "$TMP/icecam/cache" 2>/dev/null
  cp -a "$MEDIA" "$TMP/icecam/media" 2>/dev/null
  cp -a /data/adb/lspd/log "$TMP/lsposed/log" 2>/dev/null
  getprop > "$TMP/system/getprop.txt" 2>&1
  ps -A > "$TMP/system/ps_A.txt" 2>&1
  cmd activity processes > "$TMP/system/activity_processes.txt" 2>&1
  logcat -d -v threadtime > "$TMP/logcat/logcat_full.txt" 2>&1
  logcat -d -v threadtime | grep -E 'IceCam|ProviderBridgeJson|ProviderProbe|SurfaceOwnerJson|LSPosed|Xposed|CameraManager|Camera2|CameraService|CameraProvider|CaptureRequest|OutputConfiguration|android.hardware.Camera|chrom|telegram|camera' > "$TMP/logcat/logcat_filtered.txt" 2>&1
  logcat -b crash -d -v threadtime > "$TMP/logcat/logcat_crash.txt" 2>&1
  dmesg > "$TMP/logcat/dmesg.txt" 2>&1
  getenforce > "$TMP/selinux/getenforce.txt" 2>&1
  ls -Zd /data/adb "$ICE" "$ICE"/* > "$TMP/selinux/lsZ_data_adb_icecam.txt" 2>&1
  logcat -d -v threadtime | grep -i 'avc: denied' | grep -iE 'icecam|adb_data_file|camera|provider' > "$TMP/selinux/avc_denials_icecam.txt" 2>&1
  content query --uri content://com.icecam.dev.provider/config > "$TMP/provider/config_query.txt" 2>&1
  content query --uri content://com.icecam.dev.provider/state > "$TMP/provider/state_query.txt" 2>&1
  content query --uri content://com.icecam.dev.provider/media-meta > "$TMP/provider/media_meta_query.txt" 2>&1
  dumpsys media.camera > "$TMP/camera/dumpsys_media_camera.txt" 2>&1
  dumpsys camera > "$TMP/camera/dumpsys_camera.txt" 2>&1
  cmd package list packages > "$TMP/packages/package_list.txt" 2>&1
  for P in $APP_PKG $TARGETS; do
    SAFE=$(echo "$P" | tr '.:' '__')
    cmd package path "$P" > "$TMP/packages/${SAFE}_path.txt" 2>&1
    dumpsys package "$P" > "$TMP/packages/${SAFE}_dumpsys.txt" 2>&1
    appops get "$P" > "$TMP/packages/${SAFE}_appops.txt" 2>&1
  done
  tar -czf "$OUT" -C "$TMP" . 2>/dev/null
  chmod 666 "$OUT" 2>/dev/null
  echo "exported full $OUT"
}

init_dirs

case "$1" in
  bootstrap-app)
    init_dirs
    clean_legacy
    safe_root_probe
    echo "safe bootstrap completed"
    ;;
  bootstrap-app-foreground)
    init_dirs
    clean_legacy
    safe_root_probe
    echo "foreground safe bootstrap completed"
    ;;
  status)
    echo "IceCam status"
    echo "version=$VERSION"
    echo "uid=$(id)"
    echo "ctl=$0"
    echo "module_dir=$ICE"
    echo "active=$(cat "$STATE/active" 2>/dev/null)"
    echo "prepared=$(cat "$STATE/prepared" 2>/dev/null)"
    echo "root_granted=$(cat "$STATE/root_granted" 2>/dev/null)"
    echo "root_granted_at=$(cat "$STATE/root_granted_at" 2>/dev/null)"
    echo "media=$(ls -l "$MEDIA/source" 2>/dev/null)"
    echo "config=$(cat "$CONFIG/app_config.json" 2>/dev/null)"
    echo "logs=$LOGS"
    echo "lspd_log_dir=/data/adb/lspd/log"
    ;;
  prepare-hooks)
    clean_legacy
    safe_root_probe
    echo "$(date '+%F %T') prepare-hooks requested" >> "$LOGS/hook.log"
    echo 1 > "$STATE/prepared"
    [ -f "$STATE/active" ] || echo 0 > "$STATE/active"
    chmod 755 /data/adb 2>/dev/null
    chmod 777 "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
    chmod 666 "$STATE/active" "$STATE/prepared" "$CONFIG/app_config.json" "$LOGS/hook.log" "$LOGS/module.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl" 2>/dev/null
    echo "prepared hooks"
    ;;
  start)
    clean_legacy
    safe_root_probe
    echo 1 > "$STATE/active"
    chmod 666 "$STATE/active" 2>/dev/null
    chmod 777 "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
    chmod 666 "$LOGS/module.log" "$LOGS/hook.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl" 2>/dev/null
    logcat -c 2>/dev/null
    echo "$(date '+%F %T') replacement start requested" >> "$LOGS/hook.log"
    echo "replacement active"
    ;;
  stop)
    echo 0 > "$STATE/active"
    chmod 666 "$STATE/active" 2>/dev/null
    chmod 777 "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
    chmod 666 "$LOGS/module.log" "$LOGS/hook.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl" 2>/dev/null
    echo "$(date '+%F %T') replacement stop requested" >> "$LOGS/hook.log"
    echo "replacement stopped"
    ;;
  system-probe)
    collect_system_camera_probe "/sdcard/Download/icecam_system_camera_probe_${VERSION}_$(date '+%Y%m%d_%H%M%S')"
    ;;
  logs|debug-bundle|lite-logs)
    collect_lite_debug_bundle
    ;;
  full-logs|full-debug-bundle)
    collect_full_debug_bundle
    ;;
  reset-dev-data)
    rm -rf "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
    mkdir -p "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE"
    touch "$LOGS/module.log" "$LOGS/hook.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl"
    echo 0 > "$STATE/active"
    echo 0 > "$STATE/prepared"
    cat > "$CONFIG/app_config.json" <<JSON
{
  "version":"v9.6.3-safe-surface-classifier",
  "active":false,
  "mode":"log-only",
  "cameraMode":"auto",
  "compatibilityMode":"strict-real",
  "mediaType":"none",
  "mediaPath":"/data/adb/icecam/media/source",
  "mediaMetaPath":"/data/adb/icecam/media/source.meta.json",
  "pipelineStage":"system-camera-provider-probe-passive"
}
JSON
    chmod 777 "$ICE" "$LOGS" "$CONFIG" "$STATE" "$MEDIA" "$CACHE" 2>/dev/null
    chmod 666 "$LOGS"/*.log "$STATE/active" "$STATE/prepared" "$CONFIG/app_config.json" "$CACHE"/* 2>/dev/null
    logcat -c 2>/dev/null
    echo "old dev data reset"
    ;;
  clean-all)
    rm -rf "$ICE" 2>/dev/null
    echo "icecam data removed"
    ;;
  clear-logs)
    rm -f "$LOGS"/*.log
    touch "$LOGS/module.log" "$LOGS/hook.log" "$CACHE/camera_profiles.json" "$CACHE/camera_profiles.jsonl" "$CACHE/hook_access_probe.log" "$CACHE/capture_session_events.jsonl" "$CACHE/surface_events.jsonl" "$CACHE/surface_ownership_events.jsonl" "$CACHE/renderer_events.jsonl"
    chmod 666 "$LOGS"/*.log "$CACHE"/* 2>/dev/null
    logcat -c 2>/dev/null
    echo "logs cleared"
    ;;
  *)
    echo "usage: icecamctl bootstrap-app|bootstrap-app-foreground|status|prepare-hooks|start|stop|system-probe|logs|lite-logs|full-logs|clear-logs|reset-dev-data|clean-all"
    exit 2
    ;;
esac
