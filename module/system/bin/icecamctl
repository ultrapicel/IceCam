#!/system/bin/sh
BASE=/data/adb/icecam
LOG_DIR=$BASE/logs
STATE_DIR=$BASE/state
mkdir -p "$LOG_DIR" "$STATE_DIR"
case "$1" in
  logs)
    mkdir -p /sdcard/Download
    tar -czf /sdcard/Download/icecam_logs.tar.gz "$LOG_DIR" "$STATE_DIR" 2>/dev/null
    echo /sdcard/Download/icecam_logs.tar.gz
    ;;
  status)
    echo "IceCam module v0.2.0-dev installed"
    echo "base=$BASE"
    echo "logs:"
    ls -la "$LOG_DIR" 2>/dev/null
    echo "state:"
    ls -la "$STATE_DIR" 2>/dev/null
    ;;
  prepare)
    echo "$(date '+%F %T') prepare requested" >> "$LOG_DIR/hook.log"
    echo "prepared=1" > "$STATE_DIR/hook_state"
    echo "camera_api=Camera1,Camera2,CameraX,NDK planned" > "$STATE_DIR/hook_targets"
    echo "OK prepare"
    ;;
  reset)
    rm -rf "$LOG_DIR" "$STATE_DIR"
    mkdir -p "$LOG_DIR" "$STATE_DIR"
    echo "OK reset"
    ;;
  *)
    echo "Usage: icecamctl {logs|status|prepare|reset}"
    ;;
esac
